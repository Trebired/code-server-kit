{
  "name": "@trebired/code-server-kit",
  "version": "1.4.9",
  "description": "Framework-agnostic code-server integration layer for Bun hosts with preparation, launch planning, lifecycle control, diagnostics, and Linux-first systemd support.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "name": "trebired"
    }
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs prepare-dist",
    "postpack": "bun ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && bun ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun run verify:pack",
    "prepare:generated": "bun ./scripts/build/generated/tsconfig.mjs",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "verify:pack": "bun ./scripts/verify-pack.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.2.11",
    "@package/result": "npm:@trebired/result@^1.1.4",
    "code-server": "^4.117.0"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^4.9.2",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "code-server",
    "launcher",
    "backend",
    "integration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/code-server-kit"
  },
  "homepage": "https://github.com/Trebired/code-server-kit#readme",
  "bugs": {
    "url": "https://github.com/Trebired/code-server-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
