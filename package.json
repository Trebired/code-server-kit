{
  "bugs": {
    "url": "https://github.com/Trebired/code-server-kit/issues"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.2.3",
    "@package/result": "npm:@trebired/result@^1.0.1",
    "code-server": "^4.117.0"
  },
  "description": "Framework-agnostic code-server integration layer for Node.js apps with preparation, launch planning, lifecycle control, diagnostics, and Linux-first systemd support.",
  "devDependencies": {
    "@trebired/code-discipline": "^4.7.1",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/Trebired/code-server-kit#readme",
  "keywords": [
    "code-server",
    "node",
    "launcher",
    "backend",
    "integration"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@trebired/code-server-kit",
  "packageManager": "bun@1.3.12",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/code-server-kit"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/prepare-dist.mjs prepare-dist",
    "postpack": "node ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && node ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun test && bun run verify:pack",
    "test": "bun -e \"console.log(\\\"No tests configured.\\\")\"",
    "typecheck": "tsc --noEmit",
    "verify:pack": "node ./scripts/verify-pack.mjs"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.4.4"
}
